# ===================================================
# PieX (πX) — Environment Variables for Vercel
# ===================================================

# PostgreSQL Database URL (Neon, Supabase, AWS RDS, etc.)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Auth.js / NextAuth Secrets
AUTH_SECRET="your-generated-auth-secret-32-chars-min"
NEXTAUTH_SECRET="your-generated-auth-secret-32-chars-min"

# Canonical URL (Optional on Vercel, defaults to your Vercel deployment URL)
NEXTAUTH_URL="https://your-deployment-name.vercel.app"
